		logger.info("insert kyc update date sql  :  "+sql);
		try {
			int a=jdbcTemplate.update(sql);
			logger.info("No of rows updated :  "+a);
		}catch(Exception e) {
			logger.error("Exception  ",e);
		}
	}

	
