	@Override
	public boolean checkIfCifPresent(String cif) {
		try {
			String sql = "select 1 from kyc_Perfios_customer_details where cif_number = ?";
			Integer result = jdbcTemplate.queryForObject(sql, Integer.class, cif);
			return (result != null && result == 1);
		}catch(EmptyResultDataAccessException e) {
			logger.error("Cif not found   "+e.getMessage());
		}catch(Exception e) {
			logger.error("Exception  "+e.getLocalizedMessage());
			logger.error("Exception  ", e);
		}
		return false;
	}
	
	
