	private boolean fileCanProcess(Path file) {
		long now = System.currentTimeMillis();
		long stabilityMillis = TimeUnit.SECONDS.toMillis(timeInMillis);
		logger.info("path >>  " + file);
		try{
			BasicFileAttributes attrs = Files.readAttributes(file, BasicFileAttributes.class);
			long diff=now-attrs.lastModifiedTime().toMillis();
			logger.info("diff  " + diff+" , stabilityMillis "+stabilityMillis);
			return diff>=stabilityMillis;
		} catch (Exception e) {
			// throw new UncheckedIOException("Failed to list input directory " + path, e);
			logger.error("e.getMessage() >>  " + e.getMessage());
		}
		return true;
	}
